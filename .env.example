# Shared config contract — every package reads these names. Never hardcode ports/URLs/secrets.

# --- Postgres (PostGIS + TimescaleDB) ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change-me-demo-only
POSTGRES_DB=sentinel
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sentinel:change-me-demo-only@db:5432/sentinel

# App role used by backend (not a superuser; no UPDATE/DELETE on audit_log)
DATABASE_APP_USER=sentinel_app
DATABASE_APP_PASSWORD=change-me-app-role
DATABASE_URL_APP=postgresql://sentinel_app:change-me-app-role@db:5432/sentinel

# --- JWT / crypto ---
JWT_SECRET=generate-a-32-byte-random-string-and-rotate
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=8h
ALERT_HMAC_SECRET=generate-a-separate-32-byte-hmac-secret

# --- Services ---
BACKEND_PORT=4000
ANPR_SERVICE_PORT=5000
FRONTEND_PORT=3000
ANPR_SERVICE_URL=http://anpr-service:5000
BACKEND_API_URL=http://backend:4000
FRONTEND_ORIGIN=http://localhost:3000

# --- Object storage (cold frames / forensic stills) ---
MINIO_ROOT_USER=sentinel_minio
MINIO_ROOT_PASSWORD=change-me-minio-demo
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=sentinel-frames
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=sentinel_minio
S3_SECRET_KEY=change-me-minio-demo

# --- Demo seed accounts (local only; never use in production) ---
DEMO_ADMIN_EMAIL=admin@sentinel.local
DEMO_ADMIN_PASSWORD=ChangeMe_Admin1!
DEMO_OPERATOR_EMAIL=operator@sentinel.local
DEMO_OPERATOR_PASSWORD=ChangeMe_Operator1!
DEMO_READONLY_EMAIL=viewer@sentinel.local
DEMO_READONLY_PASSWORD=ChangeMe_Viewer1!

# --- Hackathon Grid Video Proxy ---
HACKATHON_EMAIL=your-portal-email@example.com
HACKATHON_PASSWORD=your-portal-password
